generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique
  isTextile Boolean  @default(false)
  category  String?  @default("RETAIL")
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// BUSINESS TYPE

model BusinessType {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(150)
  code        String   @unique @db.VarChar(50)
  description String?  @db.Text
  status      Status   @default(ACTIVE)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@map("business_types")
}

// DEPARTMENT

model Department {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(150)
  code      String   @unique @db.VarChar(50)
  head      String?  @db.VarChar(150)
  employees Int      @default(0)
  status    Status   @default(ACTIVE)
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  designations Designation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@index([companyId])
  @@map("departments")
}

// DESIGNATION

model Designation {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(50)
  designation String   @db.VarChar(150)
  department  String   @db.VarChar(150)
  status      Status   @default(ACTIVE)
  isTextile   Boolean  @default(false)
  category    String?  @default("RETAIL")
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  Department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  @@index([designation])
  @@index([department])
  @@index([companyId])
  @@map("designations")
}

// ==========================================
// MULTI-INDUSTRY & TENANT SYSTEM MODELS
// ==========================================

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Company {
  id         String        @id @default(uuid())
  name       String
  industryId String
  status     CompanyStatus @default(ACTIVE)

  industry   Industry        @relation(fields: [industryId], references: [id])
  users      User[]
  modules    CompanyModule[]

  branches           Branch[]
  products           Product[]
  categories         Category[]
  brands             Brand[]
  units              Unit[]
  suppliers          Supplier[]
  warehouses         Warehouse[]
  customers          Customer[]
  salesOrders        SalesOrder[]
  invoices           Invoice[]
  payments           Payment[]
  purchases          Purchase[]
  stockMovements     StockMovement[]
  stockTransfers     StockTransfer[]
  returns            Return[]
  discounts          Discount[]
  auditLogs          AuditLog[]
  systemSettings     SystemSettings[]
  roles              Role[]
  designations       Designation[]
  departments        Department[]

  gymMembers         GymMember[]
  gymPlans           GymMembershipPlan[]
  gymTrainers        GymTrainer[]
  gymAttendances     GymAttendance[]
  gymPayments        GymPayment[]

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@map("companies")
}

model Industry {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique @db.VarChar(50)
  status    Boolean  @default(true)

  companies Company[]
  modules   IndustryModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("industries")
}

model Module {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  status      Boolean  @default(true)

  industries  IndustryModule[]
  companies   CompanyModule[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("modules")
}

model IndustryModule {
  id             String   @id @default(uuid())
  industryId     String
  moduleId       String
  defaultEnabled Boolean  @default(true)

  industry       Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  module         Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([industryId, moduleId])
  @@map("industry_modules")
}

model CompanyModule {
  id        String   @id @default(uuid())
  companyId String
  moduleId  String
  enabled   Boolean  @default(true)
  config    Json?

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([companyId, moduleId])
  @@map("company_modules")
}

// ==========================================
// GYM ERP MODELS
// ==========================================

enum GymMemberStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  FROZEN
}

enum GymPlanDurationType {
  DAYS
  MONTHS
  YEARS
}

enum GymPaymentStatus {
  PAID
  PARTIALLY_PAID
  PENDING
  OVERDUE
}

model GymMember {
  id                 String          @id @default(uuid())
  companyId          String
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  memberId           String          @db.VarChar(50)
  fullName           String          @db.VarChar(150)
  gender             String?         @db.VarChar(20)
  dob                DateTime?
  phone              String          @db.VarChar(20)
  email              String?         @db.VarChar(150)
  address            String?
  emergencyContact   String?         @db.VarChar(150)
  emergencyPhone     String?         @db.VarChar(20)

  joinDate           DateTime        @default(now())
  membershipPlanId   String?
  startDate          DateTime?
  expiryDate         DateTime?

  assignedTrainerId  String?
  status             GymMemberStatus @default(ACTIVE)
  notes              String?
  photo              String?

  plan               GymMembershipPlan? @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)
  trainer            GymTrainer?        @relation(fields: [assignedTrainerId], references: [id], onDelete: SetNull)
  attendances        GymAttendance[]
  payments           GymPayment[]

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([companyId, memberId])
  @@index([companyId])
  @@index([status])
  @@map("gym_members")
}

model GymMembershipPlan {
  id           String              @id @default(uuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name         String              @db.VarChar(100)
  duration     Int
  durationType GymPlanDurationType @default(MONTHS)
  price        Decimal             @db.Decimal(18, 2)
  joiningFee   Decimal             @default(0.00) @db.Decimal(18, 2)
  description  String?
  benefits     Json?
  status       Status              @default(ACTIVE)

  members      GymMember[]
  payments     GymPayment[]

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([companyId])
  @@map("gym_membership_plans")
}

model GymTrainer {
  id             String      @id @default(uuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  trainerId      String      @db.VarChar(50)
  fullName       String      @db.VarChar(150)
  phone          String      @db.VarChar(20)
  email          String?     @db.VarChar(150)
  specialization String?     @db.VarChar(150)
  experience     Int?        @default(0)
  salary         Decimal?    @db.Decimal(18, 2)
  joiningDate    DateTime    @default(now())
  status         Status      @default(ACTIVE)
  photo          String?

  assignedMembers GymMember[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([companyId, trainerId])
  @@index([companyId])
  @@map("gym_trainers")
}

model GymAttendance {
  id           String      @id @default(uuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  memberId     String
  member       GymMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  date         DateTime    @default(now())
  checkInTime  DateTime?
  checkOutTime DateTime?
  status       String      @default("PRESENT") // PRESENT / ABSENT

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([companyId])
  @@index([memberId])
  @@index([date])
  @@map("gym_attendances")
}

model GymPayment {
  id               String           @id @default(uuid())
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  paymentNumber    String           @db.VarChar(50)
  memberId         String
  member           GymMember        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  membershipPlanId String?
  plan             GymMembershipPlan? @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)

  totalAmount      Decimal          @db.Decimal(18, 2)
  paidAmount       Decimal          @db.Decimal(18, 2)
  pendingAmount    Decimal          @default(0.00) @db.Decimal(18, 2)
  paymentMethod    PaymentMethod    @default(CASH)
  paymentDate      DateTime         @default(now())
  status           GymPaymentStatus @default(PAID)
  receiptNumber    String?          @db.VarChar(50)
  notes            String?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([companyId])
  @@index([memberId])
  @@map("gym_payments")
}

model User {
  id String @id @default(uuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  fullName String?

  email String @unique

  employeeId String? @unique

  phone String @unique

  passwordHash String

  plainPassword String?

  isVerified Boolean @default(false)

  firstLogin Boolean @default(true)

  verificationToken   String?
  verificationExpires DateTime?

  role String?

  roleId String?

  type String?

  roleRef Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  branchId String?

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model EmailOTP {
  id String @id @default(uuid())

  email String

  otp String

  isUsed Boolean @default(false)

  expiresAt DateTime

  createdAt DateTime @default(now())
}

model Customer {
  id       String  @id @default(uuid()) @db.Uuid
  branchId String? @map("branch_id") @db.Uuid

  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name    String
  phone   String  @unique
  email   String? @unique
  address String?

  loyaltyId String? @map("loyalty_id")

  creditLimit    Decimal @default(0.00) @map("credit_limit") @db.Decimal(18, 2)
  currentBalance Decimal @default(0.00) @map("current_balance") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  payments Payment[]

  @@index([companyId])
  @@map("customers")
}

//Status

enum Status {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductDiscountType {
  PERCENT
  FIXED
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  PARTIAL
  CANCELLED
}

enum TransferStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum MovementType {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

// CATEGORY

model Category {
  id String @id @default(uuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String @db.VarChar(100)

  code String @db.VarChar(20)

  description String?

  image String?

  status Status @default(ACTIVE)

  products Product[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@index([companyId])
  @@map("categories")
}

// BRAND

enum BrandStatus {
  ACTIVE
  INACTIVE
}

model Brand {
  id String @id @default(uuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String @db.VarChar(100)

  description String? @db.Text

  status BrandStatus @default(ACTIVE)

  products Product[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("brands")
}

// PRODUCT

model Unit {
  id String @id @default(uuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String @db.VarChar(50)

  code String @db.VarChar(20)

  status Status @default(ACTIVE)

  products Product[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([companyId])
  @@map("units")
}

model Product {
  id String @id @default(uuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String @db.VarChar(150)

  sku String @db.VarChar(50)

  barcode String? @db.VarChar(100)

  categoryId String

  subcategory String? @db.VarChar(100)

  brandId String?

  unitId String

  costPrice Decimal @db.Decimal(18, 2)

  sellingPrice Decimal @db.Decimal(18, 2)

  wholesalePrice Decimal? @db.Decimal(18, 2)

  retailPrice Decimal? @db.Decimal(18, 2)

  discountType ProductDiscountType?

  discountValue Decimal? @db.Decimal(18, 2)

  taxRate Decimal? @db.Decimal(5, 2)

  image String?

  description String?

  status ProductStatus @default(ACTIVE)

  // Textile Fabric Specifications
  isTextile Boolean @default(true)

  fabricComposition String? @db.VarChar(150)

  gsm Float?

  rollWidth Float?

  widthUnit String? @db.VarChar(20)

  color String? @db.VarChar(50)

  colorCode String? @db.VarChar(50)

  pattern String? @db.VarChar(100)

  weaveType String? @db.VarChar(100)

  textureFinish String? @db.VarChar(100)

  // Advanced Inventory Fields
  stockUnit String? @db.VarChar(50)

  initialStock Float? @default(0)

  openingStockDate DateTime?

  reorderLevel Int? @default(0)

  minimumStock Int? @default(0)

  maximumStock Int?

  warehouseLocation String? @db.VarChar(150)

  rackLocation String? @db.VarChar(100)

  numberOfRolls Int? @default(0)

  // Supplier Information
  supplierId String?

  supplierProductCode String? @db.VarChar(100)

  leadTime Int?

  hasVariants Boolean @default(false)

  unit Unit @relation(fields: [unitId], references: [id])

  category Category @relation(fields: [categoryId], references: [id])

  brand Brand? @relation(fields: [brandId], references: [id])

  supplier Supplier? @relation(fields: [supplierId], references: [id])

  barcodes Barcode[]

  inventories Inventory[]

  purchaseItems PurchaseItem[]

  transferItems StockTransferItem[]

  stockMovements StockMovement[]

  variants ProductVariant[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([categoryId])
  @@index([brandId])
  @@index([unitId])
  @@index([supplierId])
  @@map("products")
}

// BARCODE

model Barcode {
  id String @id @default(uuid())

  productId String

  barcode String @db.VarChar(100)

  type String @default("CODE128")

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId])
  @@map("barcodes")
}

// PRODUCT VARIANT

model ProductVariant {
  id String @id @default(uuid())

  productId String

  sku String? @db.VarChar(50)

  barcode String? @db.VarChar(100)

  color String? @db.VarChar(50)

  colorCode String? @db.VarChar(50)

  rollWidth Float?

  widthUnit String? @db.VarChar(20)

  gsm Float?

  pattern String? @db.VarChar(100)

  weaveType String? @db.VarChar(100)

  textureFinish String? @db.VarChar(100)

  stock Float @default(0)

  numberOfRolls Int? @default(0)

  costPrice Decimal? @db.Decimal(18, 2)

  sellingPrice Decimal? @db.Decimal(18, 2)

  wholesalePrice Decimal? @db.Decimal(18, 2)

  retailPrice Decimal? @db.Decimal(18, 2)

  status ProductStatus @default(ACTIVE)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

// SUPPLIER

model Supplier {
  id String @id @default(uuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  companyName String @db.VarChar(150)

  contactPerson String? @db.VarChar(100)

  email String? @db.VarChar(150)

  phone String @db.VarChar(20)

  address String?

  city String?

  state String?

  country String?

  taxNumber String?

  status Status @default(ACTIVE)

  category String? @default("RETAIL") @db.VarChar(50)

  isTextile Boolean @default(false)

  purchases Purchase[]

  products Product[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyName])
  @@map("suppliers")
}

// WAREHOUSE

model Warehouse {
  id String @id @default(uuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String @db.VarChar(150)

  code String @db.VarChar(50)

  address String?

  city String?

  state String?

  country String?

  phone String?

  status Status @default(ACTIVE)

  type String? @default("RETAIL_WH") @db.VarChar(50)

  isTextile Boolean @default(false)

  inventories Inventory[]

  stockMovements StockMovement[]

  purchases Purchase[]

  fromTransfers StockTransfer[] @relation("FromWarehouse")

  toTransfers StockTransfer[] @relation("ToWarehouse")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([code])
  @@index([companyId])
  @@map("warehouses")
}

// INVENTORY

model Inventory {
  id String @id @default(uuid())

  productId String

  warehouseId String

  quantity Int @default(0)

  minimumStock Int @default(10)

  maximumStock Int @default(1000)

  reorderLevel Int @default(20)

  product Product @relation(fields: [productId], references: [id])

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("inventory")
}

// PURCHASE

model Purchase {
  id String @id @default(uuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  purchaseNo String @db.VarChar(50)

  supplierId String

  warehouseId String

  purchaseDate DateTime @default(now())

  totalAmount Decimal @db.Decimal(18, 2)

  status PurchaseStatus @default(PENDING)

  notes String?

  supplier Supplier @relation(fields: [supplierId], references: [id])

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  items PurchaseItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([supplierId])
  @@index([warehouseId])
  @@map("purchases")
}

model PurchaseItem {
  id String @id @default(uuid())

  purchaseId String

  productId String

  quantity Int

  unitPrice Decimal @db.Decimal(18, 2)

  totalPrice Decimal @db.Decimal(18, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// STOCK MOVEMENT HISTORY

model StockMovement {
  id String @id @default(uuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productId String

  warehouseId String

  type MovementType

  quantity Int

  referenceNo String?

  remarks String?

  performedBy String?

  product Product @relation(fields: [productId], references: [id])

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock_movements")
}

// STOCK TRANSFER

model StockTransfer {
  id String @id @default(uuid())

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  transferNo String @db.VarChar(50)

  fromWarehouseId String
  toWarehouseId   String

  transferDate DateTime @default(now())

  status TransferStatus @default(PENDING)

  reason String?

  remarks String?

  approvedBy String?

  fromWarehouse Warehouse @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])

  toWarehouse Warehouse @relation("ToWarehouse", fields: [toWarehouseId], references: [id])

  items StockTransferItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id String @id @default(uuid())

  stockTransferId String

  productId String

  quantity Int

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id])

  product Product @relation(fields: [productId], references: [id])

  @@index([stockTransferId])
  @@index([productId])
  @@map("stock_transfer_items")
}

model SalesOrder {
  id String @id @default(uuid()) @db.Uuid

  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId   String  @map("branch_id") @db.Uuid
  customerId String? @map("customer_id") @db.Uuid

  orderNumber String @map("order_number")

  status SalesOrderStatus @default(DRAFT)

  orderDate DateTime @map("order_date")

  totalAmount Decimal @map("total_amount") @db.Decimal(18, 2)

  taxAmount Decimal @default(0.00) @map("tax_amount") @db.Decimal(18, 2)

  discountAmount Decimal @default(0.00) @map("discount_amount") @db.Decimal(18, 2)

  netAmount Decimal @map("net_amount") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("sales_orders")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

model Invoice {
  id String @id @default(uuid()) @db.Uuid

  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId     String  @map("branch_id") @db.Uuid
  salesOrderId String? @map("sales_order_id") @db.Uuid
  customerId   String  @map("customer_id") @db.Uuid

  invoiceNumber String @map("invoice_number")

  invoiceDate DateTime  @map("invoice_date")
  dueDate     DateTime? @map("due_date")

  subtotal Decimal @db.Decimal(18, 2)

  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(18, 2)

  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(18, 2)

  totalAmount Decimal @map("total_amount") @db.Decimal(18, 2)

  paidAmount Decimal @default(0) @map("paid_amount") @db.Decimal(18, 2)

  balanceAmount Decimal @default(0) @map("balance_amount") @db.Decimal(18, 2)

  paymentStatus PaymentStatus @default(PENDING)

  status InvoiceStatus @default(DRAFT)

  notes String?

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  items InvoiceItem[]

  payments Payment[]

  @@index([companyId])
  @@map("invoices")
}

model InvoiceItem {
  id String @id @default(uuid()) @db.Uuid

  invoiceId String @map("invoice_id") @db.Uuid

  productId String @map("product_id") @db.Uuid

  quantity Int

  unitPrice Decimal @map("unit_price") @db.Decimal(18, 2)

  discount Decimal @default(0) @db.Decimal(18, 2)

  tax Decimal @default(0) @db.Decimal(18, 2)

  total Decimal @db.Decimal(18, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

// ==============================
// Payment Enums
// ==============================

enum PaymentMethod {
  CASH
  CARD
  BANK
  WALLET
  OTHER
}

// ==============================
// Payment Model
// ==============================

model Payment {
  id String @id @default(uuid()) @db.Uuid

  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId        String  @map("branch_id") @db.Uuid
  customerId      String? @map("customer_id") @db.Uuid
  supplierId      String? @map("supplier_id") @db.Uuid
  invoiceId       String? @map("invoice_id") @db.Uuid
  purchaseOrderId String? @map("purchase_order_id") @db.Uuid

  paymentNumber String   @map("payment_number")
  paymentDate   DateTime @map("payment_date")

  amount Decimal @db.Decimal(18, 2)

  method PaymentMethod

  referenceNumber String? @map("reference_number")

  status PaymentStatus @default(PENDING)

  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Existing models only
  customer Customer? @relation(fields: [customerId], references: [id])
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id])

  @@index([companyId])
  @@map("payments")
}

// ==============================
// Return Enums
// ==============================

enum ReturnType {
  SALES_RETURN
  PURCHASE_RETURN
}

// ==============================
// Return Model
// ==============================

model Return {
  id String @id @default(uuid()) @db.Uuid

  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId String @map("branch_id") @db.Uuid

  type ReturnType

  referenceSalesOrderId String? @map("reference_sales_order_id") @db.Uuid

  referencePurchaseOrderId String? @map("reference_purchase_order_id") @db.Uuid

  returnNumber String @map("return_number")

  returnDate DateTime @map("return_date")

  totalAmount Decimal @map("total_amount") @db.Decimal(18, 2)

  taxAmount Decimal @default(0.00) @map("tax_amount") @db.Decimal(18, 2)

  netAmount Decimal @map("net_amount") @db.Decimal(18, 2)

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("returns")
}

// ==============================
// Discount Enums
// ==============================

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DiscountStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

// ==============================
// Discount Model
// ==============================

model Discount {
  id String @id @default(uuid()) @db.Uuid

  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  branchId String @map("branch_id") @db.Uuid

  name String @db.VarChar(100)

  code String @db.VarChar(50)

  type DiscountType

  value Decimal @db.Decimal(18, 2)

  minimumOrderAmount Decimal @default(0) @map("minimum_order_amount") @db.Decimal(18, 2)

  maximumDiscount Decimal? @map("maximum_discount") @db.Decimal(18, 2)

  startDate DateTime @map("start_date")

  endDate DateTime @map("end_date")

  status DiscountStatus @default(ACTIVE)

  description String?

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("discounts")
}

